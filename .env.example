# Скопируй в .env и заполни реальными значениями: cp .env.example .env

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-example-token

# Адрес OpenAI-совместимого API (обычно заканчивается на /v1)
LLM_BASE_URL=https://api.example.com/v1

# Ключ доступа к API
LLM_API_KEY=sk-example-key

# (необязательно) HTTP-прокси для Telegram API: http://хост:порт или http://логин:пароль@хост:порт
# Если пусто или закомментировано — прямое подключение.
# TELEGRAM_PROXY_URL=http://proxy.local:8080
