# Copy to .env and fill in real values: cp .env.example .env

# Bot token from @BotFather
BOT_TOKEN=1234567890:AAAA-example-token

# OpenAI-compatible API base URL (usually ends with /v1)
LLM_BASE_URL=https://api.example.com/v1

# API access key
LLM_API_KEY=sk-example-key

# (optional) Proxy for the Telegram API. Supported schemes: http, socks4, socks5.
# With auth: scheme://user:password@host:port. Empty or commented out = direct connection.
# Applies to Telegram traffic only; LLM requests always go direct.
# TELEGRAM_PROXY_URL=socks5://proxy.local:1080

# (optional) Bearer token for the MCP tool server (config.yaml -> tools.mcp).
# tools.mcp.auth_env NAMES this variable — any name works, the value itself
# must live here in .env, never in config.yaml.
# MCP_TOKEN=example-mcp-token
